@model Order

<h2>Check out now</h2>
<p>Please enter your details, and we'll ship your goods right away!</p>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Checkout" method="post">
    <h3>Ship to</h3>
    <div class="form-group">
        <label for="Name" asp-for="Name">Name:</label><input id="Name" asp-for="Name" class="form-control" />
    </div>
    <h3>Address</h3>
    <div class="form-group">
        <label for="Line1" asp-for="Line1">Line 1:</label><input id="Line1" asp-for="Line1" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Line2" asp-for="Line2">Line 2:</label><input id="Line2" asp-for="Line2" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Line3" asp-for="Line3">Line 3:</label><input id="Line3" asp-for="Line3" class="form-control" />
    </div>
    <div class="form-group">
        <label for="City" asp-for="City">City:</label><input id="City" asp-for="City" class="form-control" />
    </div>
    <div class="form-group">
        <label for="State" asp-for="State">State:</label><input id="State" asp-for="State" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Zip" asp-for="Zip">Zip:</label><input id="Zip" asp-for="Zip" class="form-control" />
    </div>
    <div class="form-group">
        <label for="Country" asp-for="Country">Country:</label><input id="Country" asp-for="Country" class="form-control" />
    </div>
    <h3>Options</h3>
    <div class="checkbox">
        <label>
            <input asp-for="GiftWrap" /> Gift wrap these items
        </label>
    </div>
    <div class="text-center">
        <input class="btn btn-primary" type="submit" value="Complete Order" />
    </div>
</form>
